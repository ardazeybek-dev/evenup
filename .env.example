# Copy to .env and adjust. Real environment variables always win over this file.

# Interface and port for `evenup serve` (use 0.0.0.0 inside containers)
EVENUP_HOST=127.0.0.1
PORT=5317

# Largest number of people with a balance solved exactly (0-22).
# The exact solver uses 2^n states: 20 ≈ 9 MB and well under a second.
EVENUP_EXACT_LIMIT=20

# Maximum request body for the API, in kilobytes
EVENUP_MAX_BODY_KB=256

# Comma-separated origins allowed to call the API from a browser (empty = same origin only)
EVENUP_CORS_ORIGINS=

# Trace, Debug, Information, Warning, Error, Critical
EVENUP_LOG_LEVEL=Warning
